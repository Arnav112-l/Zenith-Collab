# Database (MongoDB Atlas)
# Get your connection string from MongoDB Atlas: https://cloud.mongodb.com
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/zenith?retryWrites=true&w=majority"

# Must match client NEXTAUTH_SECRET (used to verify collab JWTs)
NEXTAUTH_SECRET="your-nextauth-secret"

# Collab server port
PORT=4000

# Email Configuration for Calendar Notifications
# For Gmail: Enable 2-factor authentication and generate an App Password
# Settings > Security > 2-Step Verification > App passwords
EMAIL_SERVICE="gmail"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="your-email@gmail.com"

# For other email services:
# - Outlook/Hotmail: Use your Microsoft account credentials (EMAIL_SERVICE="outlook")
# - Yahoo: Enable "Allow apps that use less secure sign in" (EMAIL_SERVICE="yahoo")
# - Custom SMTP: Configure EMAIL_SERVICE accordingly
